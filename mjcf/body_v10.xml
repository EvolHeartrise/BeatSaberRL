  <!-- actuators in the ACTUATED 29-order of SPEC-v10 par.1.4:
       gear = tau_max, ctrl = signed gear fraction in [-1, 1] -->
  <actuator>
    <motor name="m_spine_pitch" joint="spine_pitch" gear="800.00"/>
    <motor name="m_spine_yaw" joint="spine_yaw" gear="319.93"/>
    <motor name="m_spine_roll" joint="spine_roll" gear="500.00"/>
    <motor name="m_l_arm_pitch" joint="l_arm_pitch" gear="113.84"/>
    <motor name="m_l_arm_yaw" joint="l_arm_yaw" gear="113.84"/>
