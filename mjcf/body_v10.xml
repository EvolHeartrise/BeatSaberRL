<!--
  body_v10.xml : MuJoCo ORACLE TWIN of SPEC-v10.md (env v10, frozen at P0
  2026-07-31). Same tree, joint axes, limits, explicit masses/inertias
  (inertiafromgeom=false - every <inertial> is the spec literal), capsule
  radii, motor tau_max (gear, ctrl in [-1,1]), feet welded to world,
  timestep 1/240, gravity 9.81 on -y (world is y-up; floor y=0; hit plane
  z=0). Contact roster reproduced with explicit <pair> entries only (all
  geoms contype=0 conaffinity=0): the 55 live pairs of SPEC-v10 par.2 in
  pair-id order; excluded pairs are simply absent.

  Caveats for the oracle harness (tolerance-band tests, never parity):
  - MuJoCo has NO hard omega clamps: compare against our sim with clamps
    disabled, or on low-speed trajectories (SPEC-v10 par.7 P2b).
  - MuJoCo's constraint solver is soft/Newton, not our PGS-12+Baumgarte:
    trajectories match in bands, not bitwise.
  - qpos ordering follows MJCF declaration (tree) order, NOT the actuated
    29-order: shoulders are (yaw, pitch, twist) and wrists (roll, dev,
    bend) in qpos; the harness must map. Actuator/ctrl order below IS the
    actuated 29-order of SPEC-v10 par.1.4.
  - Stacked same-body joints are declared OUTER to INNER assuming MuJoCo
    composes them in declaration order; the P2b FK cross-check vs v9 fk()
    runs FIRST and catches a reversed convention.
  - Hands are FIST-ONLY 0.35 kg (2026-08-18: controller mass removed —
    real players exploit controller motion prediction and never truly
    swing the composite mass); blades are massless ghost geoms
    with no contacts.
-->
<mujoco model="beat_arena_body_v10">
  <compiler angle="radian" inertiafromgeom="false"/>
  <option timestep="0.004166666666666667" gravity="0 -9.81 0"
          integrator="Euler"/>

  <default>
    <joint limited="true"/>
    <geom contype="0" conaffinity="0"/>
    <motor ctrllimited="true" ctrlrange="-1 1"/>
    <!-- P2b harness fix: default pair solref/solimp are too soft for the
         spec's stiff-Baumgarte contact semantics - transient presses
         punched 2 cm deep (> 2x slop). solref = 2*h, high impedance. -->
    <pair solref="0.008333 1" solimp="0.95 0.99 0.001 0.5 2"/>
  </default>

  <worldbody>
    <geom name="g_floor" type="plane" size="5 5 0.1" pos="0 0 0"
          zaxis="0 1 0" rgba="0.3 0.3 0.35 1"/>

    <body name="pelvis" pos="0 0.94 -0.65">
      <freejoint name="root"/>
      <inertial pos="0 0 0" mass="8.4"
                diaginertia="0.038640 0.101640 0.101640"/>
      <geom name="g_pelvis" type="capsule" fromto="-0.10 0 0  0.10 0 0"
            size="0.10" rgba="0.5 0.5 0.6 1"/>

      <body name="chest" pos="0 0.10 0">
        <joint name="spine_pitch" type="hinge" axis="1 0 0"
               range="-0.3490658503988659 0.7853981633974483"
               damping="4.3140"/>
        <joint name="spine_yaw" type="hinge" axis="0 1 0"
               range="-0.6981317007977318 0.6981317007977318"
               damping="1.1998"/>
        <joint name="spine_roll" type="hinge" axis="0 0 1"
               range="-0.5235987755982988 0.5235987755982988"
               damping="3.6471"/>
        <inertial pos="0 0.215 0" mass="24.2"
                  diaginertia="0.957507 0.254964 0.957507"/>
        <geom name="g_torso" type="capsule" fromto="0 0 0  0 0.43 0"
              size="0.15" rgba="0.5 0.5 0.6 1"/>

        <!-- head: WELDED (no joint) - neck fixed in v10 -->
        <body name="head" pos="0 0.66 0">
          <inertial pos="0 0 0" mass="5.2"
                    diaginertia="0.016848 0.016848 0.016848"/>
          <geom name="g_head" type="sphere" size="0.09"
                rgba="0.6 0.55 0.5 1"/>
        </body>

        <!-- left arm: shoulder joints outer->inner yaw, pitch, twist
             => R_y(yaw) R_x(-pitch) R_z(twist) = v9 arm frame M -->
        <body name="uarm_l" pos="-0.20 0.43 0">
          <joint name="l_arm_yaw" type="hinge" axis="0 1 0"
                 range="-1.7453292519943295 0.7853981633974483"
                 damping="0.42689"/>
          <joint name="l_arm_pitch" type="hinge" axis="-1 0 0"
                 range="-1.5707963267948966 1.1344640137963142"
                 damping="0.42689"/>
          <joint name="l_arm_twist" type="hinge" axis="0 0 1"
                 range="-1.5707963267948966 1.2217304763960306"
                 damping="0.07292"/>
          <inertial pos="0 0 0.175" mass="2.0"
                    diaginertia="0.029222 0.029222 0.001966"/>
          <geom name="g_uarm_l" type="capsule" fromto="0 0 0  0 0 0.35"
                size="0.045" rgba="0.8 0.42 0.46 1"/>
          <body name="farm_l" pos="0 0 0.35">
            <joint name="l_elbow" type="hinge" axis="-1 0 0"
                   range="0 2.6179938779914944" damping="0.07174"/>
            <inertial pos="0 0 0.15" mass="1.2"
                      diaginertia="0.013056 0.013056 0.000931"/>
            <geom name="g_farm_l" type="capsule" fromto="0 0 0  0 0 0.30"
                  size="0.04" rgba="0.8 0.42 0.46 1"/>
            <!-- wrist joints outer->inner roll, dev, bend
                 => R_z(roll) R_y(dev) R_x(-bend); blade = hand +z -->
            <body name="hand_l" pos="0 0 0.30">
              <joint name="l_wrist_roll" type="hinge" axis="0 0 1"
                     range="0 3.141592653589793" damping="0.00159"/>
              <joint name="l_wrist_dev" type="hinge" axis="0 1 0"
                     range="-0.5235987755982988 0.2617993877991494"
                     damping="0.00159"/>
              <joint name="l_wrist_bend" type="hinge" axis="-1 0 0"
                     range="-1.6580627893946132 1.6580627893946132"
                     damping="0.00159"/>
              <inertial pos="0 0 0.06" mass="0.35"
                        diaginertia="0.000264 0.000264 0.000264"/>
              <geom name="g_fist_l" type="sphere" pos="0 0 0.06"
                    size="0.05" rgba="0.8 0.42 0.46 1"/>
              <geom name="g_blade_l" type="capsule"
                    fromto="0 0 0  0 0 1.0" size="0.02"
                    rgba="0.9 0.3 0.3 0.3"/>
            </body>
          </body>
        </body>

        <!-- right arm (limits mirrored per SPEC-v10 par.1.4) -->
