    <pair geom1="g_farm_r" geom2="g_shank_l" condim="1" margin="0.01" gap="0.005"/>
    <pair geom1="g_farm_r" geom2="g_shank_r" condim="1" margin="0.01" gap="0.005"/>
    <pair geom1="g_fist_l" geom2="g_fist_r" condim="1" margin="0.01" gap="0.005"/>
    <pair geom1="g_fist_l" geom2="g_thigh_l" condim="1" margin="0.01" gap="0.005"/>
    <pair geom1="g_fist_l" geom2="g_thigh_r" condim="1" margin="0.01" gap="0.005"/>
    <pair geom1="g_fist_l" geom2="g_shank_l" condim="1" margin="0.01" gap="0.005"/>
