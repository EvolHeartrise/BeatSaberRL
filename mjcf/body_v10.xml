          <joint name="r_arm_yaw" type="hinge" axis="0 1 0"
                 range="-0.7853981633974483 1.7453292519943295"
                 damping="0.42689"/>
          <joint name="r_arm_pitch" type="hinge" axis="-1 0 0"
                 range="-1.5707963267948966 1.1344640137963142"
                 damping="0.42689"/>
          <joint name="r_arm_twist" type="hinge" axis="0 0 1"
                 range="-1.2217304763960306 1.5707963267948966"
                 damping="0.07292"/>
          <inertial pos="0 0 0.175" mass="2.0"
                    diaginertia="0.029222 0.029222 0.001966"/>
          <geom name="g_uarm_r" type="capsule" fromto="0 0 0  0 0 0.35"
                size="0.045" rgba="0.38 0.62 0.85 1"/>
          <body name="farm_r" pos="0 0 0.35">
            <joint name="r_elbow" type="hinge" axis="-1 0 0"
                   range="0 2.6179938779914944" damping="0.07174"/>
            <inertial pos="0 0 0.15" mass="1.2"
                      diaginertia="0.013056 0.013056 0.000931"/>
            <geom name="g_farm_r" type="capsule" fromto="0 0 0  0 0 0.30"
                  size="0.04" rgba="0.38 0.62 0.85 1"/>
            <body name="hand_r" pos="0 0 0.30">
              <joint name="r_wrist_roll" type="hinge" axis="0 0 1"
                     range="-3.141592653589793 0" damping="0.00159"/>
              <joint name="r_wrist_dev" type="hinge" axis="0 1 0"
                     range="-0.2617993877991494 0.5235987755982988"
                     damping="0.00159"/>
              <joint name="r_wrist_bend" type="hinge" axis="-1 0 0"
                     range="-1.6580627893946132 1.6580627893946132"
                     damping="0.00159"/>
              <inertial pos="0 0 0.06" mass="0.35"
                        diaginertia="0.000264 0.000264 0.000264"/>
              <geom name="g_fist_r" type="sphere" pos="0 0 0.06"
                    size="0.05" rgba="0.38 0.62 0.85 1"/>
              <geom name="g_blade_r" type="capsule"
                    fromto="0 0 0  0 0 1.0" size="0.02"
                    rgba="0.3 0.5 0.9 0.3"/>
            </body>
          </body>
        </body>
      </body>

      <!-- left leg: hip joints outer->inner pitch, yaw, roll
           => R_x(-pitch) R_y(yaw) R_z(roll); thigh along local -y -->
      <body name="thigh_l" pos="-0.10 0 0">
        <joint name="l_hip_pitch" type="hinge" axis="-1 0 0"
               range="-0.3490658503988659 2.0943951023931953"
               damping="1.8175"/>
        <joint name="l_hip_yaw" type="hinge" axis="0 1 0"
               range="-0.7853981633974483 0.6981317007977318"
               damping="0.28120"/>
        <joint name="l_hip_roll" type="hinge" axis="0 0 1"
               range="-0.7853981633974483 0.5235987755982988"
               damping="1.8133"/>
        <inertial pos="0 -0.22 0" mass="10.6"
                  diaginertia="0.250198 0.018493 0.250198"/>
        <geom name="g_thigh_l" type="capsule" fromto="0 0 0  0 -0.44 0"
              size="0.06" rgba="0.5 0.5 0.6 1"/>
        <body name="shank_l" pos="0 -0.44 0">
          <joint name="l_knee" type="hinge" axis="1 0 0"
                 range="0 2.6179938779914944" damping="0.26294"/>
          <inertial pos="0 -0.215 0" mass="3.2"
                    diaginertia="0.065964 0.003161 0.065964"/>
          <geom name="g_shank_l" type="capsule" fromto="0 0 0  0 -0.43 0"
                size="0.045" rgba="0.5 0.5 0.6 1"/>
          <body name="foot_l" pos="0 -0.43 0">
            <joint name="l_ankle_pitch" type="hinge" axis="-1 0 0"
                   range="-0.8726646259971648 0.3490658503988659"
                   damping="0.00561"/>
            <joint name="l_ankle_roll" type="hinge" axis="0 0 1"
                   range="-0.3490658503988659 0.3490658503988659"
                   damping="0.00138"/>
            <inertial pos="0 -0.035 0.05" mass="1.0"
                      diaginertia="0.005617 0.005883 0.001083"/>
            <geom name="g_foot_l" type="box" pos="0 -0.035 0.05"
                  size="0.045 0.035 0.125" rgba="0.4 0.4 0.45 1"/>
          </body>
        </body>
      </body>

      <!-- right leg (hip yaw/roll limits mirrored) -->
      <body name="thigh_r" pos="0.10 0 0">
        <joint name="r_hip_pitch" type="hinge" axis="-1 0 0"
               range="-0.3490658503988659 2.0943951023931953"
               damping="1.8175"/>
        <joint name="r_hip_yaw" type="hinge" axis="0 1 0"
               range="-0.6981317007977318 0.7853981633974483"
               damping="0.28120"/>
        <joint name="r_hip_roll" type="hinge" axis="0 0 1"
               range="-0.5235987755982988 0.7853981633974483"
               damping="1.8133"/>
        <inertial pos="0 -0.22 0" mass="10.6"
                  diaginertia="0.250198 0.018493 0.250198"/>
        <geom name="g_thigh_r" type="capsule" fromto="0 0 0  0 -0.44 0"
              size="0.06" rgba="0.5 0.5 0.6 1"/>
        <body name="shank_r" pos="0 -0.44 0">
          <joint name="r_knee" type="hinge" axis="1 0 0"
                 range="0 2.6179938779914944" damping="0.26294"/>
          <inertial pos="0 -0.215 0" mass="3.2"
                    diaginertia="0.065964 0.003161 0.065964"/>
          <geom name="g_shank_r" type="capsule" fromto="0 0 0  0 -0.43 0"
                size="0.045" rgba="0.5 0.5 0.6 1"/>
          <body name="foot_r" pos="0 -0.43 0">
            <joint name="r_ankle_pitch" type="hinge" axis="-1 0 0"
                   range="-0.8726646259971648 0.3490658503988659"
                   damping="0.00561"/>
            <joint name="r_ankle_roll" type="hinge" axis="0 0 1"
                   range="-0.3490658503988659 0.3490658503988659"
                   damping="0.00138"/>
            <inertial pos="0 -0.035 0.05" mass="1.0"
                      diaginertia="0.005617 0.005883 0.001083"/>
            <geom name="g_foot_r" type="box" pos="0 -0.035 0.05"
                  size="0.045 0.035 0.125" rgba="0.4 0.4 0.45 1"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- feet welded to world at the qpos0 (reference) pose (all-zero relpose
       = "use the qpos0 relative pose"). P2b harness fixes (check_static
       diagnosis): anchor MUST be the foot's world position - the default
       anchor (0,0,0) is in body2(world) frame, i.e. the WORLD ORIGIN,
       putting the translational rows on a 0.66 m lever through the soft
       rotational rows (welds went mushy, feet tore out). solref = 2*h with
       high solimp impedance keeps the weld stiff enough to carry the 75 kg
       body (default solref/solimp let the rotation rows slip). -->
  <equality>
    <weld name="weld_foot_l" body1="foot_l" anchor="-0.10 0.07 -0.65"
          solref="0.008333 1" solimp="0.99 0.999 0.001 0.5 2"/>
    <weld name="weld_foot_r" body1="foot_r" anchor="0.10 0.07 -0.65"
          solref="0.008333 1" solimp="0.99 0.999 0.001 0.5 2"/>
  </equality>

  <!-- the 55 live pairs of SPEC-v10 par.2, in pair-id order (0-54).
       collider ids: 0 torso, 1 head, 2 uarm_l, 3 uarm_r, 4 farm_l,
       5 farm_r, 6 fist_l, 7 fist_r, 8 thigh_l, 9 thigh_r, 10 shank_l,
       11 shank_r. Frictionless (condim 1), restitution 0 (default),
       margin 0.01 / gap 0.005 approximates our activation margin+slop. -->
  <contact>
    <pair geom1="g_torso" geom2="g_farm_l" condim="1" margin="0.01" gap="0.005"/>
    <pair geom1="g_torso" geom2="g_farm_r" condim="1" margin="0.01" gap="0.005"/>
    <pair geom1="g_torso" geom2="g_fist_l" condim="1" margin="0.01" gap="0.005"/>
    <pair geom1="g_torso" geom2="g_fist_r" condim="1" margin="0.01" gap="0.005"/>
    <pair geom1="g_torso" geom2="g_shank_l" condim="1" margin="0.01" gap="0.005"/>
    <pair geom1="g_torso" geom2="g_shank_r" condim="1" margin="0.01" gap="0.005"/>
    <pair geom1="g_head" geom2="g_uarm_l" condim="1" margin="0.01" gap="0.005"/>
    <pair geom1="g_head" geom2="g_uarm_r" condim="1" margin="0.01" gap="0.005"/>
    <pair geom1="g_head" geom2="g_farm_l" condim="1" margin="0.01" gap="0.005"/>
    <pair geom1="g_head" geom2="g_farm_r" condim="1" margin="0.01" gap="0.005"/>
    <pair geom1="g_head" geom2="g_fist_l" condim="1" margin="0.01" gap="0.005"/>
    <pair geom1="g_head" geom2="g_fist_r" condim="1" margin="0.01" gap="0.005"/>
    <pair geom1="g_head" geom2="g_thigh_l" condim="1" margin="0.01" gap="0.005"/>
    <pair geom1="g_head" geom2="g_thigh_r" condim="1" margin="0.01" gap="0.005"/>
    <pair geom1="g_head" geom2="g_shank_l" condim="1" margin="0.01" gap="0.005"/>
    <pair geom1="g_head" geom2="g_shank_r" condim="1" margin="0.01" gap="0.005"/>
    <pair geom1="g_uarm_l" geom2="g_uarm_r" condim="1" margin="0.01" gap="0.005"/>
    <pair geom1="g_uarm_l" geom2="g_farm_r" condim="1" margin="0.01" gap="0.005"/>
    <pair geom1="g_uarm_l" geom2="g_fist_l" condim="1" margin="0.01" gap="0.005"/>
    <pair geom1="g_uarm_l" geom2="g_fist_r" condim="1" margin="0.01" gap="0.005"/>
    <pair geom1="g_uarm_l" geom2="g_thigh_l" condim="1" margin="0.01" gap="0.005"/>
    <pair geom1="g_uarm_l" geom2="g_thigh_r" condim="1" margin="0.01" gap="0.005"/>
    <pair geom1="g_uarm_l" geom2="g_shank_l" condim="1" margin="0.01" gap="0.005"/>
    <pair geom1="g_uarm_l" geom2="g_shank_r" condim="1" margin="0.01" gap="0.005"/>
    <pair geom1="g_uarm_r" geom2="g_farm_l" condim="1" margin="0.01" gap="0.005"/>
    <pair geom1="g_uarm_r" geom2="g_fist_l" condim="1" margin="0.01" gap="0.005"/>
    <pair geom1="g_uarm_r" geom2="g_fist_r" condim="1" margin="0.01" gap="0.005"/>
    <pair geom1="g_uarm_r" geom2="g_thigh_l" condim="1" margin="0.01" gap="0.005"/>
    <pair geom1="g_uarm_r" geom2="g_thigh_r" condim="1" margin="0.01" gap="0.005"/>
