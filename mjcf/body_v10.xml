    <motor name="m_l_hip_pitch" joint="l_hip_pitch" gear="350.00"/>
    <motor name="m_l_hip_yaw" joint="l_hip_yaw" gear="100.00"/>
    <motor name="m_l_hip_roll" joint="l_hip_roll" gear="180.00"/>
    <motor name="m_l_knee" joint="l_knee" gear="250.00"/>
    <motor name="m_l_ankle_pitch" joint="l_ankle_pitch" gear="180.00"/>
    <motor name="m_l_ankle_roll" joint="l_ankle_roll" gear="50.00"/>
