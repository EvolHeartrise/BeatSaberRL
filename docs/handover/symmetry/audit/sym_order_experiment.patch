+
+pub fn sym_mode() -> u32 {
+    static V: std::sync::OnceLock<u32> = std::sync::OnceLock::new();
+    *V.get_or_init(|| std::env::var("SYM_MODE").ok().and_then(|s| s.parse().ok()).unwrap_or(0))
+}
+pub fn sym_corner() -> bool {
+    static V: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *V.get_or_init(|| std::env::var("SYM_CORNER").map(|s| s == "1").unwrap_or(false))
+}
+
+pub fn sym_order() -> bool {
+    static V: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *V.get_or_init(|| std::env::var("SYM_ORDER").map(|s| s == "1").unwrap_or(false))
+}
+const JMIRROR: [usize; 29] = [0, 1, 2, 10, 11, 12, 13, 14, 15, 16, 3, 4, 5, 6, 7, 8, 9,
+                              23, 24, 25, 26, 27, 28, 17, 18, 19, 20, 21, 22];
+#[inline(always)]
+pub fn jorder(k: usize) -> usize { if k < 29 && sym_j() { JMIRROR[k] } else { k } }
+pub fn pair_order(k: usize) -> usize {
+    if !sym_p() { return k; }
+    static T: std::sync::OnceLock<[usize; 55]> = std::sync::OnceLock::new();
+    T.get_or_init(|| {
+        use dynamics::collide::PAIRS;
+        let cm = [0usize, 1, 3, 2, 5, 4, 7, 6, 9, 8, 11, 10];
+        let mut t = [0usize; 55];
+        for k in 0..55 {
+            let (a, b) = PAIRS[k];
+            let (ma, mb) = (cm[a].min(cm[b]), cm[a].max(cm[b]));
+            t[k] = PAIRS.iter().position(|&p| p == (ma, mb)).unwrap();
+        }
+        t
+    })[k]
+}
+
+fn flag(name: &str) -> bool { std::env::var(name).map(|s| s == "1").unwrap_or(false) }
+pub fn sym_j() -> bool { static V: std::sync::OnceLock<bool> = std::sync::OnceLock::new(); *V.get_or_init(|| sym_order() || flag("SYM_J")) }
+pub fn sym_p() -> bool { static V: std::sync::OnceLock<bool> = std::sync::OnceLock::new(); *V.get_or_init(|| sym_order() || flag("SYM_P")) }
+pub fn sym_g() -> bool { static V: std::sync::OnceLock<bool> = std::sync::OnceLock::new(); *V.get_or_init(|| sym_order() || flag("SYM_G")) }
+
+pub fn jorder_x(k: usize, which: u8) -> usize {
+    static V: std::sync::OnceLock<[bool; 3]> = std::sync::OnceLock::new();
+    let f = V.get_or_init(|| [sym_j() || flag("SYM_JL"), sym_j() || flag("SYM_JC"), sym_j() || flag("SYM_JS")]);
+    if f[which as usize] { JMIRROR[k] } else { k }
+}
